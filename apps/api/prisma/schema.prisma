generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ConversationStatus {
  open
  assigned
  pending
  resolved
  bot_handling
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageStatus {
  pending
  sent
  delivered
  read
  failed
}

enum Channel {
  whatsapp
  telegram
}

model Contact {
  id                  String               @id @default(uuid()) @db.Uuid
  phoneNumber         String               @unique @map("phone_number")
  name                String?
  profileName         String?              @map("profile_name")
  tags                String[]             @default([])
  metadata            Json                 @default("{}")
  optedOut            Boolean              @default(false) @map("opted_out")
  optedOutAt          DateTime?            @map("opted_out_at")
  telegramChatId      String?              @unique @map("telegram_chat_id")
  telegramUsername    String?              @map("telegram_username")
  preferredChannel    Channel              @default(whatsapp) @map("preferred_channel")
  createdAt           DateTime             @default(now()) @map("created_at")
  lastMessageAt       DateTime?            @map("last_message_at")
  conversations       Conversation[]
  campaignRecipients  CampaignRecipient[]
  debts               Debt[]

  @@index([optedOut])
  @@index([preferredChannel])
  @@map("contacts")
}

model Conversation {
  id                 String             @id @default(uuid()) @db.Uuid
  contactId          String             @map("contact_id") @db.Uuid
  contact            Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status             ConversationStatus @default(open)
  assignedAgentId    String?            @map("assigned_agent_id") @db.Uuid
  currentFlowId      String?            @map("current_flow_id") @db.Uuid
  currentFlowNodeId  String?            @map("current_flow_node_id")
  context            Json               @default("{}")
  windowExpiresAt    DateTime?          @map("window_expires_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  messages           Message[]
  notes              Note[]
  currentFlow        Flow?              @relation(fields: [currentFlowId], references: [id], onDelete: SetNull)

  @@index([contactId])
  @@index([status])
  @@map("conversations")
}

model Flow {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  triggerType   String         @map("trigger_type") // default | keyword | intent
  triggerValue  String?        @map("trigger_value")
  priority      Int            @default(100)
  isActive      Boolean        @default(true) @map("is_active")
  definition    Json
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  conversations Conversation[]

  @@index([isActive, priority])
  @@map("flows")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

enum CampaignStatus {
  draft
  queued
  sending
  completed
  cancelled
  failed
}

enum CampaignRecipientStatus {
  pending
  queued
  sent
  delivered
  read
  failed
  skipped_opted_out
}

model Campaign {
  id                String              @id @default(uuid()) @db.Uuid
  name              String
  templateId        String              @map("template_id") @db.Uuid
  template          Template            @relation(fields: [templateId], references: [id])
  parameterMapping  Json                @map("parameter_mapping") // [{index:1, kind:'contact_field'|'static', field?, value?}, ...]
  audienceFilter    Json                @map("audience_filter")   // {kind:'tag'|'all'|'ids', ...}
  status            CampaignStatus      @default(draft)
  totalRecipients   Int                 @default(0) @map("total_recipients")
  createdById       String?             @map("created_by_id") @db.Uuid
  createdBy         User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  startedAt         DateTime?           @map("started_at")
  completedAt       DateTime?           @map("completed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  recipients        CampaignRecipient[]

  @@index([status])
  @@map("campaigns")
}

model CampaignRecipient {
  id                String                  @id @default(uuid()) @db.Uuid
  campaignId        String                  @map("campaign_id") @db.Uuid
  campaign          Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId         String                  @map("contact_id") @db.Uuid
  contact           Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  resolvedParams    Json                    @map("resolved_params") // ["Carolina","viernes 15"]
  status            CampaignRecipientStatus @default(pending)
  whatsappMessageId String?                 @unique @map("whatsapp_message_id")
  errorMessage      String?                 @map("error_message")
  sentAt            DateTime?               @map("sent_at")
  deliveredAt       DateTime?               @map("delivered_at")
  readAt            DateTime?               @map("read_at")
  createdAt         DateTime                @default(now()) @map("created_at")

  @@unique([campaignId, contactId])
  @@index([status])
  @@index([whatsappMessageId])
  @@map("campaign_recipients")
}

enum TemplateStatus {
  draft
  pending
  approved
  rejected
  paused
  disabled
}

model Template {
  id              String         @id @default(uuid()) @db.Uuid
  name            String         @unique
  language        String
  category        String         // MARKETING | UTILITY | AUTHENTICATION
  status          TemplateStatus @default(draft)
  metaTemplateId  String?        @map("meta_template_id")
  components      Json
  rejectionReason String?        @map("rejection_reason")
  lastSyncedAt    DateTime?      @map("last_synced_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  campaigns       Campaign[]
  debts           Debt[]

  @@index([status])
  @@map("templates")
}

enum DebtStatus {
  active
  paid
  cancelled
  overdue
}

enum InstallmentStatus {
  pending
  scheduled
  sent
  paid
  overdue
  failed
}

model Debt {
  id                String        @id @default(uuid()) @db.Uuid
  contactId         String        @map("contact_id") @db.Uuid
  contact           Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  description       String?
  totalAmount       Decimal       @map("total_amount") @db.Decimal(14, 2)
  currency          String        @default("COP")
  installmentCount  Int           @map("installment_count")
  paymentDayOfMonth Int           @map("payment_day_of_month")
  firstDueDate      DateTime      @map("first_due_date") @db.Date
  paymentLink       String?       @map("payment_link")
  templateId        String?       @map("template_id") @db.Uuid
  template          Template?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  parameterMapping  Json          @map("parameter_mapping") @default("[]")
  status            DebtStatus    @default(active)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  installments      Installment[]

  @@index([contactId])
  @@index([status])
  @@map("debts")
}

model Installment {
  id                  String              @id @default(uuid()) @db.Uuid
  debtId              String              @map("debt_id") @db.Uuid
  debt                Debt                @relation(fields: [debtId], references: [id], onDelete: Cascade)
  number              Int
  amount              Decimal             @db.Decimal(14, 2)
  dueDate             DateTime            @map("due_date") @db.Date
  status              InstallmentStatus   @default(pending)
  reminderSentAt      DateTime?           @map("reminder_sent_at")
  paidAt              DateTime?           @map("paid_at")
  paymentLink         String?             @map("payment_link")
  whatsappMessageId   String?             @map("whatsapp_message_id")
  errorMessage        String?             @map("error_message")
  combopayInvoiceId   String?             @unique @map("combopay_invoice_id")
  combopayMetadata    Json?               @map("combopay_metadata")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@unique([debtId, number])
  @@index([status, dueDate])
  @@map("installments")
}

enum UserRole {
  admin
  agent
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  role         UserRole   @default(agent)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  sessions     Session[]
  notes        Note[]
  auditLogs    AuditLog[]
  campaigns    Campaign[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  ip        String?
  userAgent String?  @map("user_agent")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Note {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("notes")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Message {
  id                  String           @id @default(uuid()) @db.Uuid
  conversationId      String           @map("conversation_id") @db.Uuid
  conversation        Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  whatsappMessageId   String?          @unique @map("whatsapp_message_id")
  direction           MessageDirection
  type                String
  content             Json
  status              MessageStatus    @default(pending)
  sentBy              String?          @map("sent_by")
  errorMessage        String?          @map("error_message")
  createdAt           DateTime         @default(now()) @map("created_at")

  @@index([conversationId])
  @@index([whatsappMessageId])
  @@map("messages")
}
